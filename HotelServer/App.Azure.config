<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="HotelConnection" connectionString="Server=tcp:nhom4.database.windows.net,1433;Initial Catalog=dbMyHotel;User ID=nhom4;Password=ENTER_PASSWORD_ON_VM;Encrypt=True;TrustServerCertificate=False;Connect Timeout=60" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="DatabaseInitializationMode" value="Existing" />
    <add key="TransportSecurity" value="Tls12" />
    <add key="TlsServerCertificateThumbprint" value="" />
    <add key="ListenAddress" value="0.0.0.0" />
    <add key="ListenPort" value="8888" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
